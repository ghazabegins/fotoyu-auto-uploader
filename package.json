{
  "name": "fotoyu-uploader-desktop",
  "version": "1.3.0",
  "description": "Real-Time Automated Event Photo Uploader for Fotoyu API",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder build --publish never",
    "build:win": "electron-builder build --win --publish never",
    "build:mac": "electron-builder build --mac --arm64 --x64 --publish never"
  },
  "keywords": [
    "electron",
    "fotoyu",
    "uploader",
    "chokidar",
    "ftp",
    "photography",
    "real-time"
  ],
  "author": "Fotoyu Engineering",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.8",
    "chokidar": "^3.6.0",
    "electron-store": "^8.1.0",
    "form-data": "^4.0.0",
    "ftp-srv": "^4.6.3"
  },
  "devDependencies": {
    "electron": "^29.1.5",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "publish": null,
    "appId": "com.fotoyu.autouploader",
    "productName": "Fotoyu Uploader Pro",
    "compression": "maximum",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "!src/**/*.test.js",
      "!src/**/*.spec.js",
      "package.json"
    ],
    "asarUnpack": [
      "src/main/scripts/**/*"
    ],
    "extraResources": [
      {
        "from": "build/panduan.txt",
        "to": "panduan.txt"
      },
      {
        "from": "build/Buka_Aplikasi_Mac.command",
        "to": "Buka_Aplikasi_Mac.command"
      }
    ],
    "mac": {
      "category": "public.app-category.photography",
      "icon": "build/icon.png",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null,
      "extendInfo": {
        "NSCameraUsageDescription": "FotoSync PRO memerlukan izin akses kamera USB untuk Live Shutter Ingest.",
        "NSAppleEventsUsageDescription": "FotoSync PRO memerlukan izin integrasi sistem untuk deteksi kamera.",
        "NSDesktopFolderUsageDescription": "FotoSync PRO memerlukan akses folder untuk menyimpan foto Live Shutter.",
        "NSDocumentsFolderUsageDescription": "FotoSync PRO memerlukan akses folder untuk menyimpan foto Live Shutter.",
        "NSDownloadsFolderUsageDescription": "FotoSync PRO memerlukan akses folder untuk menyimpan foto Live Shutter."
      },
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "format": "ULFO"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "differentialPackage": false,
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Fotoyu Uploader Pro",
      "uninstallDisplayName": "Uninstall Fotoyu Uploader Pro",
      "perMachine": false,
      "allowElevation": true,
      "runAfterFinish": true
    }
  }
}
