{
  "name": "fotoyu-uploader-desktop",
  "version": "1.0.0",
  "description": "Real-Time Automated Event Photo Uploader for Fotoyu API",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder build --publish never",
    "build:win": "electron-builder build --win --publish never",
    "build:mac": "electron-builder build --mac --arm64 --publish never"
  },
  "keywords": [
    "electron",
    "fotoyu",
    "uploader",
    "chokidar",
    "ftp",
    "photography",
    "real-time"
  ],
  "author": "Fotoyu Engineering",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.8",
    "chokidar": "^3.6.0",
    "electron-store": "^8.1.0",
    "form-data": "^4.0.0"
  },
  "devDependencies": {
    "electron": "^29.1.5",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "publish": null,
    "appId": "com.fotoyu.autouploader",
    "productName": "Fotoyu Uploader Pro",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "src/main/scripts/**/*"
    ],
    "mac": {
      "category": "public.app-category.photography",
      "icon": "build/icon.png",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null,
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "zip",
        "nsis"
      ]
    },
    "nsis": {
      "differentialPackage": false,
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FotoSync PRO",
      "uninstallDisplayName": "Uninstall FotoSync PRO",
      "perMachine": false,
      "allowElevation": true,
      "runAfterFinish": true
    }
  }
}
